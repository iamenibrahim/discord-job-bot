DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/PASTE_YOURS_HERE
POLL_SECONDS=300
LISTINGS_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/.github/scripts/listings.json

# Optional: @everyone, <@USER_ID>, or <@&ROLE_ID>
MENTION=

# false = first run only records existing jobs and does not spam them
SEND_EXISTING_ON_FIRST_RUN=false

STATE_FILE=seen_jobs.json

# Safe local verification: fetch and print only; never contact Discord
DRY_RUN=false
